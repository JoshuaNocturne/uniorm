@PACKAGE_INIT@

# uniorm::uniorm is the only exported target. Its own dependencies -- the ODBC
# driver manager and threads -- are PRIVATE to the shared library and get
# resolved when libuniorm loads, so there is nothing to find_dependency here: a
# consumer must not have to locate a driver manager it does not link against.
include("${CMAKE_CURRENT_LIST_DIR}/uniormTargets.cmake")

check_required_components(uniorm)
